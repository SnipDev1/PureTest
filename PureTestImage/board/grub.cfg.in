# PureTestImage grub.cfg - single config for both BIOS and UEFI boot.
# The root partition is found by its filesystem label; kernel + initramfs
# live on that same root partition (/boot), so nothing needs the ESP.

set default="0"
set timeout="3"
set color_normal=white/black
set color_highlight=black/white

# Load filesystem and search modules explicitly — grub-install may or may
# not have embedded them into the core image depending on the target.
insmod part_gpt
insmod fat
insmod ext2
insmod search
insmod search_label
insmod linux

search --no-floppy --set=root --label PUREROOT

menuentry "PureTestImage - benchmark" {
	linux /boot/vmlinuz root=LABEL=PUREROOT rw quiet console=tty1 console=ttyS0 amd_pstate=active cpufreq.default_governor=performance
	initrd /boot/initrd.img
}

menuentry "PureTestImage - verbose debug boot" {
	linux /boot/vmlinuz root=LABEL=PUREROOT rw systemd.show_status=1 systemd.log_level=debug console=tty1 console=ttyS0 amd_pstate=active cpufreq.default_governor=performance
	initrd /boot/initrd.img
}

menuentry "Reboot" {
	reboot
}

menuentry "Poweroff" {
	halt
}
