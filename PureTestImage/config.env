# ==============================================================================
# PureTestImage Configuration File (DATADISK/config.env)
# ==============================================================================
# Этот файл считывается автоматически при загрузке системы с флешки.
# Любые параметры можно изменять в Windows без пересборки образа!
# ==============================================================================

# Количество повторений каждого теста (по умолчанию: 3)
RUNS=3

# Лимит времени на один прогон теста в секундах (по умолчанию: 600)
TIMEOUT=600

# Степень АО (Автоматической / Архитектурной оптимизации компилятора):
#   O0    - без оптимизации (-O0 -fno-builtin, чистый базовый уровень)
#   O1    - базовая оптимизация (-O1)
#   O2    - стандартная оптимизация (-O2 -march=native, по умолчанию)
#   O3    - максимальная оптимизация (-O3 -march=native, автовекторизация)
#   Ofast - экстремальная (-Ofast -march=native -flto)
#   Os    - оптимизация по размеру (-Os)
#   all   - последовательный бенчмарк по ВСЕМ степеням АО с матрицей ускорения
AO_LEVEL=O2

# Базовые флаги компилятора g++ (тесты могут дополнять их через свой build.flags)
# По умолчанию: -O2 -march=native
FLAGS="-O2 -march=native"

# Режим управления частотой процессора (CPU governor)
# Варианты: performance (по умолчанию), powersave, schedutil, ondemand
GOVERNOR=performance

# Действие после завершения пакетного режима AUTORUN / run_list.txt:
#   poweroff - выключить машину (по умолчанию)
#   menu     - вернуться в интерактивное меню выбора тестов
#   reboot   - перезагрузить машину
#   shell    - остаться в root-консоли bash
AFTER_AUTORUN=poweroff
