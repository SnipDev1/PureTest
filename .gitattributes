# Auto detect text files and perform LF normalization
* text=auto

# Enforce Unix LF line endings for all shell scripts (critical for Linux / boot USB)
*.sh text eol=lf
*.bash text eol=lf
*.cfg text eol=lf
*.in text eol=lf
*.env text eol=lf
*.service text eol=lf
*.conf text eol=lf

# Enforce Windows CRLF line endings for batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code & configs
*.cpp text
*.cc text
*.cxx text
*.c text
*.h text
*.hpp text
*.md text
*.txt text
*.json text
*.tsv text

# Binary files
*.img binary
*.iso binary
*.tar.gz binary
*.obj binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
